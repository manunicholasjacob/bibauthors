# Python
__pycache__/
*.py[cod]

# Builds and installs
build/
dist/
*.egg-info/

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# bibauthor's own outputs
.bibauthor-cache/
bibauthor-report.json
# written by the Action self-test job in .github/workflows/ci.yml
bibauthor-selftest-*.json

# NOT ignored, on purpose: tests/fixtures/cache/ is committed so the whole
# test suite runs offline. If those recorded HTTP responses go missing, every
# provider test turns into a cache miss and the suite either fails or starts
# reaching out to someone else's server. Do not add it here.
